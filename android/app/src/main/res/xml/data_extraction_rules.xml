<?xml version="1.0" encoding="utf-8"?>
<!-- android:dataExtractionRules: read by Android 12 (API 31) and later.
     cloud-backup: Google's backup. device-transfer: a transfer to a new
     phone; for an app targeting 31 or higher Android ignores
     fullBackupContent there, so this section is the only thing that keeps
     these files out of a transfer.
     Exclusions only, no inclusions: everything not listed here is still
     backed up and transferred, the drive diary (domain "root") included on
     purpose. domain="file" is Context.getFilesDir().
     Held to the Dart constants by
     test/architectural/backup_exclusion_rules_test.dart; keep both sections
     and backup_rules.xml identical. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="error_log.txt" />
        <exclude domain="file" path="fix_timing_record.txt" />
        <exclude domain="file" path="fix_timing_record.stopped" />
        <exclude domain="file" path="fix_interval_record_15.txt" />
        <exclude domain="file" path="fix_interval_record_15.stopped" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="error_log.txt" />
        <exclude domain="file" path="fix_timing_record.txt" />
        <exclude domain="file" path="fix_timing_record.stopped" />
        <exclude domain="file" path="fix_interval_record_15.txt" />
        <exclude domain="file" path="fix_interval_record_15.stopped" />
    </device-transfer>
</data-extraction-rules>
