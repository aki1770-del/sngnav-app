<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required so live weather/routing fetches work in RELEASE builds.
         (debug/profile manifests declare INTERNET separately and merge it
         into those variants; release uses only this main manifest.) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Foreground-only location: shows HER live position dot on the snow map
         while driving. NO ACCESS_BACKGROUND_LOCATION by design (the app is
         foreground-only; background tracking would be a dignity over-reach). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- WS5 actuator channel: WAKE_LOCK holds the screen on so a driver
         glancing at a live hazard never finds a dark screen (wakelock_plus). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Foreground-service perms RETURNED 2026-09-24, on the exact condition
         the 2026-07-10 removal set: "when the explicit, user-visible,
         driver-initiated ongoing-drive Service is actually built,
         FOREGROUND_SERVICE + FOREGROUND_SERVICE_LOCATION return in the same
         change-set." They do, and this is that change-set.

         The Service is NOT newly written and NOT ours: it is
         com.baseflow.geolocator.GeolocatorLocationService, already declared
         with android:foregroundServiceType="location" in geolocator_android's
         own manifest and already merged into our APK (verified in
         build/app/intermediates/merged_manifests/release/.../AndroidManifest.xml).
         What was missing was never the Service — it was these two permissions
         and the Dart-side AndroidSettings.foregroundNotificationConfig that
         tells it to go foreground. That wiring is in lib/her_position.dart.

         Both are load-bearing, not decorative: targetSdk is 36 (measured on
         the installed package), and from API 34 a location-typed foreground
         service that calls startForeground WITHOUT
         FOREGROUND_SERVICE_LOCATION throws SecurityException. FOREGROUND_SERVICE
         has been required since API 28.

         What she gets: a drive SHE starts (the "現在地を共有" button), a
         persistent notification she can see for as long as it runs, tapping it
         returns her to the app, and 停止 ends the drive AND the service
         (geolocator disables background mode when the last stream listener
         detaches — StreamHandlerImpl.java:155).

         ACCESS_BACKGROUND_LOCATION IS STILL WITHHELD. Unchanged, and not ours
         to move: no silent, notification-less background location. The service
         only ever runs behind a notification she started and can end. If a
         future change wants location without that notification, it is a
         different decision and belongs to the Chair, not to this file. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <application
        android:label="SNGNav"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- flutter_tts package-visibility requirement (Android 11+ /
             targetSdk >= 30): without this, the engine cannot see the
             system TTS service and speak() fails SILENTLY — the ja voice
             channel HER relies on dies with no error surfaced (our speak
             call is inside a catch). Mandated by the flutter_tts README. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
